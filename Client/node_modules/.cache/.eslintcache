atalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"144","messages":"145","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"74"},"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\index.js",[],["146","147"],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Redux\\store.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\App.js",["148"],"import './App.css';\r\nimport 'bootstrap/dist/css/bootstrap.min.css';\r\n\r\nimport { Routes,Route, Navigate} from \"react-router-dom\";\r\nimport LoginPrincipal from './Component/Login/Login_Principal/LoginPrincipal';\r\n\r\nimport Home from './Component/home/Home';\r\nimport PerfilUser from './Component/Usuario/Perfil_User/Perfil_User';\r\nimport CompanyHome from './Component/Company/Company_home/CompanyHome';\r\nimport CompanyZapatos from './Component/Company/Company_Zapatos/CompanyZapatos';\r\nimport CompanyOrders from './Component/Company/Company_Order/CompanyOrders';\r\nimport CompanyStock from './Component/Company/Company_stock/CompanyStock';\r\nimport Carrito from './Component/Carrito/Carrito_Card/Carri_Compras_User';\r\nimport CompraRespuesta from './Component/Carrito/Carrito_Respuesta/Carro_Respuesta';\r\nimport ComprasUser from './Component/Usuario/Compras_User/Compras_User';\r\nimport ErrorPage from './Component/ErrorPage/ErrorPage';\r\n\r\n\r\nfunction App() {\r\n  return (\r\n    <div className=\"App\">\r\n \r\n      <Routes>\r\n              \r\n              <Route path='/' element={<LoginPrincipal/>}/>\r\n              <Route path='/home' element={<Home/>}/>\r\n\r\n              <Route path='/perfiluser' element={<PerfilUser/>}/>\r\n\r\n              <Route path='/perfilusuario' element={<PerfilUser/>}/>\r\n              <Route path='/company' element={<CompanyHome/>}/>\r\n              <Route path='/company/zapatos' element={<CompanyZapatos/>}/>\r\n              <Route path='/company/ventas' element={<CompanyOrders/>}/>\r\n              <Route path='/company/stock' element={<CompanyStock/>}/>\r\n              <Route path='/user/carrito' element={<Carrito/>}/>\r\n              <Route path='/user/carrito/respuesta' element={<CompraRespuesta/>}/>\r\n              <Route path='/user/compras' element={<ComprasUser/>}/>\r\n            \r\n          <Route path=\"*\" element={<ErrorPage/>} />\r\n        </Routes>\r\n   \r\n     \r\n   \r\n     \r\n\r\n\r\n    </div>\r\n    \r\n  );\r\n}\r\n\r\n\r\n\r\n\r\n\r\nexport default App;\r\n","C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\reportWebVitals.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Redux\\reducer.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\loading\\Loading.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\home\\Home.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Login\\Login_Principal\\LoginPrincipal.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\navMenu\\NavMenu.js",["149"],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Login\\Login_User\\Login_User.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\navFilter\\navFilter.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Olvidecontrasena\\Olvidecontrasena.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Login\\Registrar_Usuario\\Registrar_Usuario.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Usuario\\Perfil_User\\Perfil_User.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Redux\\Action-Tipes-js\\actions-type-empresa.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Redux\\Action-Tipes-js\\actions-type-usuario.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Login\\Login_Empresa\\Registrar_Empresa.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Redux\\Actions\\Empresa\\Actions-Empresa.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Redux\\Actions\\Usuario\\Action-user.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Company\\Company_home\\CompanyHome.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Company\\Company_Menu\\CompanyMenu.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Company\\Company_Datos\\CompanyDatos.js",["150","151"],"import React, { useState, useEffect } from 'react';\r\nimport './Company.Datos.css';\r\nimport { useDispatch, useSelector } from 'react-redux';\r\nimport { Actualizar_Datos_Company } from '../../../Redux/Actions/Empresa/Actions-Empresa'\r\nimport alertify from 'alertifyjs';\r\nimport 'alertifyjs/build/css/alertify.css';\r\n\r\nimport img from '../Company_img/depositphotos_59468249-stock-photo-shoes-on-the-shelf.jpg';\r\n\r\n\r\n\r\n\r\n//firebase\r\nimport {getFirestore, collection, addDoc } from 'firebase/firestore'\r\nimport {getStorage, ref, uploadBytes, getDownloadURL } from 'firebase/storage'\r\nimport appfirebase from '../../../credenciales';\r\n\r\n\r\nconst storange = getStorage(appfirebase)\r\nconst db = getFirestore(appfirebase);\r\n\r\n\r\nconst CompanyDatos = () => {\r\n  const Empresa = useSelector((state) => state.EMPRESA);\r\n  const dispatch = useDispatch()\r\n\r\n  const initialData = {\r\n    nombre: Empresa.name,\r\n    correo: Empresa.correo,\r\n    celular: Empresa.celular,\r\n    direccion: 'Calle Principal #123',\r\n    descripcion: Empresa.Descripcion,\r\n    url: 'https://st2.depositphotos.com/1000333/5946/i/450/depositphotos_59468249-stock-photo-shoes-on-the-shelf.jpg',\r\n    status: Empresa.status,\r\n  };\r\n\r\n  const [dataCompany, setDataCompany] = useState(initialData);\r\n  const [editable, setEditable] = useState(false);\r\n  const [imageFile, setImageFile] = useState(null); // Estado para manejar el archivo de imagen\r\n  const [imagePreview, setImagePreview] = useState(Empresa.url); // Estado para la vista previa de la imagen\r\n\r\n  useEffect(() => {\r\n    setDataCompany({\r\n      id:Empresa.is,\r\n      nombre: Empresa.name,\r\n      correo: Empresa.correo,\r\n      celular: Empresa.celular,\r\n      direccion: 'Calle Principal #123',\r\n      descripcion: Empresa.Descripcion,\r\n      url: Empresa.url,\r\n      status: Empresa.status,\r\n    });\r\n    setImagePreview(Empresa.url || 'https://firebasestorage.googleapis.com/v0/b/stylezapapp.appspot.com/o/documentos%2Fstock-vector-cartoon-shoe-comic-book-sports-clothing-retro-vector-comics-pop-art-design-2425165073.jpg?alt=media&token=2fdb1bb0-1534-4dbf-972a-862eeb1b3c6c'); // Si no hay URL de la empresa, utiliza la imagen inicial\r\n  }, [Empresa]);\r\n\r\n  const handleEdit = () => {\r\n    setEditable(true);\r\n  };\r\n\r\n  const handleCancelar = ()=>{\r\n    setEditable(false);\r\n  }\r\n\r\n  const handleSave = async() => {\r\n    alert(\"Datos \"+ JSON.stringify(imageFile))\r\n\r\n\r\n\r\n    try {\r\n      const retorno = await  dispatch(Actualizar_Datos_Company(dataCompany, Empresa.id))\r\n      alertify.alert('Mensaje', retorno.message);\r\n      setEditable(false);\r\n      // Guardar la información adicionalmente (ejemplo con Firestore)\r\n      await addDoc(collection(db, 'empresa'), {\r\n        ...dataCompany,\r\n      });\r\n  \r\n      \r\n     \r\n    } catch (error) {\r\n      console.error('Error:', error);\r\n      // Manejar errores según tu lógica de la aplicación\r\n    }\r\n\r\n\r\n    \r\n   \r\n    \r\n    // Aquí podrías enviar la información actualizada al servidor o realizar otras operaciones necesarias\r\n  };\r\n\r\n  const handleChange = (e) => {\r\n    const { name, value } = e.target;\r\n    setDataCompany({ ...dataCompany, [name]: value });\r\n  };\r\n\r\n  const handleFileChange = async (e) => {\r\n      \r\n\r\n    const file = e.target.files[0];\r\n\r\n    if (file) {\r\n        const reader = new FileReader();\r\n        reader.onloadend = () => {\r\n          setDataCompany({ ...dataCompany, url: reader.result });\r\n        };\r\n        reader.readAsDataURL(file);\r\n\r\n        const refArchivo = ref(storange, `documentos/${file.name}`);\r\n        await uploadBytes(refArchivo, file);\r\n        const urle_descarfada = await getDownloadURL(refArchivo);\r\n        //setFormData({ url: urle_descarfada });\r\n        setImagePreview(urle_descarfada)\r\n        setDataCompany({ ...dataCompany, url: urle_descarfada });\r\n    }\r\n};\r\n\r\n  return (\r\n    <div className=\"companydatos-container\">\r\n      <div className=\"companydatos-info\">\r\n        <h2>Datos de la Empresa</h2>\r\n       \r\n        <div className=\"companydatos-item\">\r\n          <strong>Nombre:</strong>{' '}\r\n          {editable ? (\r\n            <input type=\"text\" name=\"nombre\" value={dataCompany.nombre} onChange={handleChange} />\r\n          ) : (\r\n            dataCompany.nombre\r\n          )}\r\n        </div>\r\n        <div className=\"companydatos-item\">\r\n          <strong>Correo:</strong>{' '}\r\n          {editable ? (\r\n            <input type=\"text\" name=\"correo\" value={dataCompany.correo} onChange={handleChange} />\r\n          ) : (\r\n            dataCompany.correo\r\n          )}\r\n        </div>\r\n        <div className=\"companydatos-item\">\r\n          <strong>Celular o Teléfono:</strong>{' '}\r\n          {editable ? (\r\n            <input type=\"text\" name=\"celular\" value={dataCompany.celular} onChange={handleChange} />\r\n          ) : (\r\n            dataCompany.celular\r\n          )}\r\n        </div>\r\n        <div className=\"companydatos-item\">\r\n          <strong>Dirección:</strong>{' '}\r\n          {editable ? (\r\n            <input type=\"text\" name=\"direccion\" value={dataCompany.direccion} onChange={handleChange} />\r\n          ) : (\r\n            dataCompany.direccion\r\n          )}\r\n        </div>\r\n        <div className=\"companydatos-item\">\r\n          <strong>Descripción:</strong>{' '}\r\n          {editable ? (\r\n            <input type=\"text\" name=\"descripcion\" value={dataCompany.descripcion} onChange={handleChange} />\r\n          ) : (\r\n            dataCompany.descripcion\r\n          )}\r\n        </div>\r\n        <div className=\"companydatos-item\">\r\n          <strong>Estado:</strong>{' '}\r\n          {editable ? (\r\n            <input type=\"text\" name=\"status\" value={dataCompany.status} onChange={handleChange} />\r\n          ) : (\r\n            dataCompany.status\r\n          )}\r\n        </div>\r\n        <div className=\"companydatos-actions\">\r\n          {editable ? (<>\r\n            <button onClick={handleSave}>Guardar</button>\r\n            <button onClick={handleCancelar}>cancelar</button>\r\n            </>) : (\r\n            <button onClick={handleEdit}>Habilitar Edición</button>\r\n          )}\r\n        </div>\r\n      </div>\r\n      <div className='grupo-file-img'>\r\n      <div className=\"companydatos-image\">\r\n\r\n        <img src={imagePreview} alt=\"Logo de la empresa\" />\r\n      \r\n      </div>\r\n      {editable \r\n      ? <input type=\"file\" accept=\"image/*\" onChange={handleFileChange} />\r\n      :null\r\n      }\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default CompanyDatos;\r\n\r\n","C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Company\\Company_Zapatos\\CompanyZapatos.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Company\\Company_Order\\CompanyOrders.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Company\\Company_Localstorang\\Company_Localstorang.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\credenciales.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Cards\\Zapatos_card\\Zapatos_Cards.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Cards\\Zapatos_card\\card\\Zapatos_Card.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Company\\Company_stock\\CompanyStock.js",["152"],"import { useDispatch, useSelector } from \"react-redux\";\r\nimport React, {useState, useEffect} from 'react'\r\nimport {Muestra_Cards_Empresa} from '../../../Redux/Actions/Empresa/Actions-Empresa'\r\nimport Loading from \"../../loading/Loading\";\r\nimport CompanyMenu from \"../Company_Menu/CompanyMenu\";\r\nimport NavFilter from \"../../navFilter/navFilter\";\r\nimport ZapatosCards from \"../../Cards/Zapatos_card/Zapatos_Cards\";\r\n\r\nconst CompanyStock = ()=>{\r\n    const dispatch = useDispatch();\r\n    const [loading, setLoading] = useState(true);\r\n    const empresa = useSelector((state) => state.EMPRESA || []);\r\n    const cards = useSelector((state) => state.CARDS || []);\r\n  \r\n  \r\n\r\n\r\n    \r\n\r\n    useEffect(() => {\r\n        const timer = setTimeout(() => {\r\n          setLoading(false); \r\n     \r\n        }, 3000);\r\n    \r\n        return () => clearTimeout(timer);\r\n      }, [dispatch]);\r\n\r\n      useEffect(() => {\r\n     \r\n        dispatch(Muestra_Cards_Empresa(empresa.id));\r\n       }, [dispatch, empresa]);\r\n     \r\n   \r\n\r\n\r\n\r\n    return<>\r\n    {loading ? <Loading /> : null}\r\n    <CompanyMenu className=\"nav-menu\" />\r\n    <div className=\"home-body\">\r\n    <NavFilter/>\r\n    <div className=\"content-cards-empresa\">\r\n          <ZapatosCards />\r\n        </div>\r\n        </div>\r\n    \r\n    </>\r\n}\r\nexport default CompanyStock","C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Carrito\\Carrito_Card\\Carri_Compras_User.js",["153"],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Carrito\\Carrito_Localstorang\\CaritoLocalstorang.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Carrito\\Carrito_Respuesta\\Carro_Respuesta.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Usuario\\LocalStorangUser\\LocalstorangUser.js",[],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\Usuario\\Compras_User\\Compras_User.js",["154"],"C:\\Users\\Luis Buelvas\\Desktop\\Carpeta_PI\\Zapateria-Cun\\Client\\src\\Component\\ErrorPage\\ErrorPage.js",[],{"ruleId":"155","replacedBy":"156"},{"ruleId":"157","replacedBy":"158"},{"ruleId":"159","severity":1,"message":"160","line":4,"column":24,"nodeType":"161","messageId":"162","endLine":4,"endColumn":32},{"ruleId":"159","severity":1,"message":"163","line":11,"column":23,"nodeType":"161","messageId":"162","endLine":11,"endColumn":37},{"ruleId":"159","severity":1,"message":"164","line":8,"column":8,"nodeType":"161","messageId":"162","endLine":8,"endColumn":11},{"ruleId":"159","severity":1,"message":"165","line":39,"column":21,"nodeType":"161","messageId":"162","endLine":39,"endColumn":33},{"ruleId":"159","severity":1,"message":"166","line":13,"column":11,"nodeType":"161","messageId":"162","endLine":13,"endColumn":16},{"ruleId":"159","severity":1,"message":"167","line":28,"column":10,"nodeType":"161","messageId":"162","endLine":28,"endColumn":20},{"ruleId":"159","severity":1,"message":"168","line":13,"column":9,"nodeType":"161","messageId":"162","endLine":13,"endColumn":13},"no-native-reassign",["169"],"no-negated-in-lhs",["170"],"no-unused-vars","'Navigate' is defined but never used.","Identifier","unusedVar","'setShowSubMenu' is assigned a value but never used.","'img' is defined but never used.","'setImageFile' is assigned a value but never used.","'cards' is assigned a value but never used.","'urlcompras' is assigned a value but never used.","'User' is assigned a value but never used.","no-global-assign","no-unsafe-negation"]